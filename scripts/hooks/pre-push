#!/usr/bin/env bash
# pre-push hook — full gate (tests + build)
# Installed by scripts/setup-hooks.sh

set -euo pipefail

# Git exports GIT_DIR/GIT_INDEX_FILE/... to hooks. Those leak into subprocesses
# and break tests that shell out to git in temporary repositories.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_COMMON_DIR GIT_PREFIX

echo "🚀 Pre-push: running full gate"
npm run gate || {
  echo "❌ Gate failed. Fix issues before pushing."
  exit 1
}

echo "✅ Pre-push gate passed"
